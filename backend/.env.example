# ==============================================
# HydroControl Pro - Variables de Entorno
# ==============================================
# Copiar este archivo como .env y ajustar valores

# Puerto del servidor Express
PORT=3000

# Broker MQTT (Mosquitto)
MQTT_BROKER=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=hydrocontrol-server

# Base de datos SQLite
DB_PATH=./data/hydrocontrol.db

# Clave API para Grafana (opcional, para autenticación)
GRAFANA_API_KEY=

# Nivel de log: debug, info, warn, error
LOG_LEVEL=info

# Intervalo de limpieza automática en horas
CLEANUP_INTERVAL_HOURS=24

# Días de retención de datos crudos
DATA_RETENTION_DAYS=90

# WebSocket
WS_PORT=3000
WS_PATH=/ws
